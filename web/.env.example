# Doctor Tracker Frontend Environment Configuration
# Browser API Base URL using same-origin reverse proxy (/api/v1)
NEXT_PUBLIC_API_URL=/api/v1

# Server-side absolute backend API URL (used by Next.js SSR and rewrites)
# Production: https://doctor-tracker-ten-iota.vercel.app/api/v1
# Local Dev: http://localhost:5000/api/v1
INTERNAL_API_URL=http://localhost:5000/api/v1
