# Server Configuration
NODE_ENV=development
PORT=5000

# Client Configuration
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/doctor_tracker

# JWT Configuration
# Generate with: openssl rand -base64 32
JWT_SECRET=your_32_character_minimum_random_secret_here
JWT_EXPIRES_IN=1h

# Seed Admin Credentials (used by pnpm seed:admin)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@doctortracker.com
ADMIN_PASSWORD="AdminPassword#2026"
